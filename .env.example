# ── Google Cloud Vision ───────────────────────────────────────────────────────
# 1. Create a project at https://console.cloud.google.com
# 2. Enable "Cloud Vision API" for the project
# 3. Go to APIs & Services → Credentials → Create Credentials → API key
# 4. (Recommended) Restrict the key to the Cloud Vision API only
GOOGLE_VISION_API_KEY=your-api-key-here

# ── eBay Browse API ───────────────────────────────────────────────────────────
# 1. Register at https://developer.ebay.com
# 2. Go to My Account → Application Keysets and create an app
# 3. Copy the App ID (Client ID) and Client Secret from the Production keyset
# 4. Request Browse API access (required for production):
#    https://developer.ebay.com/api-docs/buy/browse/overview.html
EBAY_CLIENT_ID=your-client-id-here
EBAY_CLIENT_SECRET=your-client-secret-here

# Set to "true" to force mock eBay responses regardless of credentials.
# Mock mode is automatically enabled when the keys above are absent.
EBAY_MOCK=false

# ── MySQL (optional) ──────────────────────────────────────────────────────────
# Leave MYSQL_DATABASE unset to run without persistence (no history/analytics).
# Create the tables with:  python db.py init
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=reappraise
MYSQL_PASSWORD=choose-a-password
MYSQL_DATABASE=reappraise
# Used by tests/test_db_integration.py — every table is truncated per test,
# so this must NOT be the same database as MYSQL_DATABASE.
MYSQL_TEST_DATABASE=reappraise_test
